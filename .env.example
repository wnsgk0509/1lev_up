# ==============================================================================
# Supabase 환경변수 설정 가이드 (.env 파일에 복사하여 사용하세요)
# ==============================================================================

# 1. Supabase 프로젝트 URL (대시보드 -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. 브라우저(클라이언트)용 키: Publishable Key (권장) 또는 Anon Key
# - 최신 Supabase 대시보드의 "Publishable key" (sb_pub_... 또는 pk_...)
# - 또는 기존 JWT 포맷의 "anon public" 키 (eyJ...)
# ⚠️ 주의: 브라우저에 노출되어도 안전한 키입니다. Row Level Security(RLS)로 데이터를 보호합니다.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# ------------------------------------------------------------------------------
# 🚫 [절대 금지] Secret Key (구 service_role key)
# - Secret Key (sb_sec_... 또는 service_role)는 모든 RLS를 우회하는 마스터 키입니다.
# - 절대 Vite/React 등 브라우저 프론트엔드 코드(VITE_ 접두사)에 넣지 마세요!
# ==============================================================================
